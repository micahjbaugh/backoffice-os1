{
  "enabled": true,
  "builder": {
    "engineer": "claude",
    "model": "claude-sonnet-5",
    "max_turns": 40
  },
  "reviewer": {
    "engineer": "chatgpt",
    "provider": "openai",
    "model": "gpt-5",
    "max_diff_chars": 60000
  },
  "max_attempts_per_task": 3,
  "target_changed_lines_per_file": 150,
  "max_changed_lines_per_file": 200,
  "line_limit_exempt_paths": ["workflow/state.json", "workflow/blueprint.json", "pnpm-lock.yaml"],
  "protected_paths": [".github/", "workflow/scripts/", "workflow/config.json"],
  "pause_at_milestone_boundary": false
}
