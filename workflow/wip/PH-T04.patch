@@ -0,0 +1,68 @@
+// PH-T04: structured logging and the error-reporting interface. Pure unit tests, no database.
+
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { createConsoleLogger, createLoggingErrorReporter, type LogLevel } from "../src";
+
+function parsedLine(spy: ReturnType<typeof vi.spyOn>): Record<string, unknown> {
+  const [line] = spy.mock.calls[0] as [string];
+  return JSON.parse(line) as Record<string, unknown>;
+}
+
+describe("createConsoleLogger", () => {
+  let warnSpy: ReturnType<typeof vi.spyOn>;
+  let errorSpy: ReturnType<typeof vi.spyOn>;
+  beforeEach(() => {
+    warnSpy = vi.spyOn(console, "warn").mockImplementation(() => {});
+    errorSpy = vi.spyOn(console, "error").mockImplementation(() => {});
+  });
+  afterEach(() => {
+    warnSpy.mockRestore();
+    errorSpy.mockRestore();
+  });
+
+  it("writes error-level lines to console.error only", () => {
+    createConsoleLogger().log("error", "boom", { foo: "bar" });
+    expect(errorSpy).toHaveBeenCalledTimes(1);
+    expect(warnSpy).not.toHaveBeenCalled();
+    expect(parsedLine(errorSpy)).toMatchObject({ level: "error", message: "boom", foo: "bar" });
+    expect(typeof parsedLine(errorSpy).time).toBe("string");
+  });
+
+  it.each<LogLevel>(["info", "warn"])(
+    "writes non-error (%s) lines to console.warn only",
+    (level) => {
+      createConsoleLogger().log(level, "something happened", { foo: "bar" });
+      expect(warnSpy).toHaveBeenCalledTimes(1);
+      expect(errorSpy).not.toHaveBeenCalled();
+      expect(parsedLine(warnSpy)).toMatchObject({
+        level,
+        message: "something happened",
+        foo: "bar",
+      });
+    },
+  );
+});
+
+describe("createLoggingErrorReporter", () => {
+  it("logs the alert at error level with its type and details merged in", () => {
+    const log = vi.fn();
+    const reporter = createLoggingErrorReporter({ log });
+    reporter.captureAlert({
+      type: "webhook.dead_lettered",
+      message: "2 webhook event(s) dead-lettered this run",
+      details: { count: 2 },
+    });
+    expect(log).toHaveBeenCalledWith(
+      "error",
+      "2 webhook event(s) dead-lettered this run",
+      expect.objectContaining({ alert_type: "webhook.dead_lettered", count: 2 }),
+    );
+  });
+
+  it("defaults to a console logger when none is given", () => {
+    const errorSpy = vi.spyOn(console, "error").mockImplementation(() => {});
+    createLoggingErrorReporter().captureAlert({ type: "x", message: "y" });
+    expect(errorSpy).toHaveBeenCalledTimes(1);
+    errorSpy.mockRestore();
+  });
+});
