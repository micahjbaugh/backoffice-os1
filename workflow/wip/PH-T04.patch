+++ b/packages/workflows/test/jobs.test.ts
@@ -0,0 +1,86 @@
+// PH-T04: runBackgroundJobs alerts through the injected ErrorReporter exactly when a pass produces a
+// new dead-lettered webhook or a newly escalated (unknown) outbound operation, and stays silent
+// otherwise. The sub-steps themselves (webhook processing, dispatch, reconciliation, retention) are
+// covered elsewhere (outbound.test.ts, retention.test.ts); here they are faked so this stays a fast,
+// database-free unit test of the alerting wiring.
+
+import { beforeEach, describe, expect, it, vi } from "vitest";
+import type { ErrorReporter } from "@backoffice/core";
+
+const processWebhookEvents = vi.fn();
+const dispatchOutboundOperations = vi.fn();
+const reconcileUnknownOperations = vi.fn();
+const purgeExpiredRetention = vi.fn();
+
+vi.mock("../src/webhook-processor", () => ({
+  createWebhookHandlers: () => ({}),
+  processWebhookEvents,
+}));
+vi.mock("../src/outbound-dispatcher", () => ({
+  dispatchOutboundOperations,
+  reconcileUnknownOperations,
+}));
+vi.mock("../src/retention-purge", () => ({ purgeExpiredRetention }));
+
+const NO_WEBHOOKS = { claimed: 0, processed: 0, ignored: 0, retrying: 0, dead: 0 };
+const NO_OUTBOUND = { claimed: 0, succeeded: 0, retrying: 0, failed: 0, unknown: 0 };
+const NO_RECONCILIATION = { reconciled: 0, escalated: 0 };
+
+function fakeReporter(): ErrorReporter & {
+  captureAlert: ReturnType<typeof vi.fn<ErrorReporter["captureAlert"]>>;
+} {
+  return { captureAlert: vi.fn<ErrorReporter["captureAlert"]>() };
+}
+
+beforeEach(() => {
+  processWebhookEvents.mockReset().mockResolvedValue(NO_WEBHOOKS);
+  dispatchOutboundOperations.mockReset().mockResolvedValue(NO_OUTBOUND);
+  reconcileUnknownOperations.mockReset().mockResolvedValue(NO_RECONCILIATION);
+  purgeExpiredRetention.mockReset().mockResolvedValue({});
+});
+
+describe("runBackgroundJobs alerting", () => {
+  it("does not alert when nothing is stuck", async () => {
+    const { runBackgroundJobs } = await import("../src/jobs");
+    const reporter = fakeReporter();
+    await runBackgroundJobs({} as never, {} as never, { reporter });
+    expect(reporter.captureAlert).not.toHaveBeenCalled();
+  });
+
+  it("alerts once when webhook events are dead-lettered this run", async () => {
+    processWebhookEvents.mockResolvedValue({ ...NO_WEBHOOKS, claimed: 3, dead: 2 });
+    const { runBackgroundJobs } = await import("../src/jobs");
+    const reporter = fakeReporter();
+    await runBackgroundJobs({} as never, {} as never, { reporter });
+    expect(reporter.captureAlert).toHaveBeenCalledTimes(1);
+    expect(reporter.captureAlert).toHaveBeenCalledWith(
+      expect.objectContaining({
+        type: "webhook.dead_lettered",
+        details: { count: 2 },
+      }),
+    );
+  });
+
+  it("alerts once when outbound operations are newly escalated as unknown", async () => {
+    reconcileUnknownOperations.mockResolvedValue({ reconciled: 1, escalated: 3 });
+    const { runBackgroundJobs } = await import("../src/jobs");
+    const reporter = fakeReporter();
+    await runBackgroundJobs({} as never, {} as never, { reporter });
+    expect(reporter.captureAlert).toHaveBeenCalledTimes(1);
+    expect(reporter.captureAlert).toHaveBeenCalledWith(
+      expect.objectContaining({
+        type: "outbound_operation.unknown",
+        details: { count: 3 },
+      }),
+    );
+  });
+
+  it("falls back to the default logging reporter when none is given", async () => {
+    processWebhookEvents.mockResolvedValue({ ...NO_WEBHOOKS, claimed: 1, dead: 1 });
+    const errorSpy = vi.spyOn(console, "error").mockImplementation(() => {});
+    const { runBackgroundJobs } = await import("../src/jobs");
+    await runBackgroundJobs({} as never, {} as never);
+    expect(errorSpy).toHaveBeenCalledTimes(1);
+    errorSpy.mockRestore();
+  });
+});
