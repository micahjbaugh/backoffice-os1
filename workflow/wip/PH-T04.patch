   dispatchOutboundOperations,
@@ -23,15 +23,37 @@ export interface JobsSummary {
   retention: RetentionPurgeSummary;
 }
 
+/**
+ * PH-T04: a webhook event only ever counts toward `dead` the run it first dies (it is excluded from
+ * later claims), and an outbound operation only ever counts toward `escalated` the run it first gets
+ * an ops case (`reconcileOutboundOperation` short-circuits once `ops_case_id` is set). So each alert
+ * fires exactly once per incident, not on every subsequent pass.
+ */
 export async function runBackgroundJobs(
   db: Database,
   runtime: ProviderRuntime,
+  opts: { reporter?: ErrorReporter } = {},
 ): Promise<JobsSummary> {
+  const reporter = opts.reporter ?? createLoggingErrorReporter();
   const webhooks = await processWebhookEvents(db, {
     handlers: createWebhookHandlers(runtime.extractor),
   });
+  if (webhooks.dead > 0) {
+    reporter.captureAlert({
+      type: "webhook.dead_lettered",
+      message: `${webhooks.dead} webhook event(s) dead-lettered this run`,
+      details: { count: webhooks.dead },
+    });
+  }
   const outbound = await dispatchOutboundOperations(db, runtime);
   const reconciliation = await reconcileUnknownOperations(db, runtime);
+  if (reconciliation.escalated > 0) {
+    reporter.captureAlert({
+      type: "outbound_operation.unknown",
+      message: `${reconciliation.escalated} outbound operation(s) escalated as unknown this run`,
+      details: { count: reconciliation.escalated },
+    });
+  }
   const retention = await purgeExpiredRetention(db);
   return { webhooks, outbound, reconciliation, retention };
 }
diff --git a/packages/workflows/test/jobs.test.ts b/packages/workflows/test/jobs.test.ts
