diff --git a/packages/core/src/services/monitoring.ts b/packages/core/src/services/monitoring.ts
new file mode 100644
index 0000000..ecb2355
--- /dev/null
+++ b/packages/core/src/services/monitoring.ts
@@ -0,0 +1,61 @@
+// Structured logging and an error-reporting interface (PH-T04): call sites depend only on
+// `Logger`/`ErrorReporter`, never on which observability provider is behind them. Which provider
+// (PagerDuty, Opsgenie, Sentry...) receives these alerts is a deployment decision left to a person,
+// the same way the rate limiter's storage backend was left open behind an interface in PH-T01.
+
+export type LogLevel = "info" | "warn" | "error";
+
+export interface LogFields {
+  [key: string]: unknown;
+}
+
+export interface Logger {
+  log(level: LogLevel, message: string, fields?: LogFields): void;
+}
+
+/**
+ * One JSON line per call, to stderr (error) or stdout (info/warn — the repository's lint rule only
+ * allows `console.warn`/`console.error`, so non-error levels share the warn stream; the `level`
+ * field in the line still carries the real severity for anything reading these logs), safe for any
+ * log aggregator to ingest. Callers are responsible for keeping `fields` free of secrets and
+ * unnecessary raw sensitive content (SECURITY.md §10): pass identifiers and counts, not customer
+ * message bodies.
+ */
+export function createConsoleLogger(): Logger {
+  return {
+    log(level, message, fields) {
+      const line = JSON.stringify({ level, message, time: new Date().toISOString(), ...fields });
+      if (level === "error") console.error(line);
+      else console.warn(line);
+    },
+  };
+}
+
+/**
+ * An operational condition worth a person's attention: a dead-lettered webhook, an outbound
+ * operation whose outcome could not be confirmed, a failed health check. `details` should stay to
+ * counts and identifiers, never raw tenant content.
+ */
+export interface AlertEvent {
+  type: string;
+  message: string;
+  details?: LogFields;
+}
+
+export interface ErrorReporter {
+  captureAlert(event: AlertEvent): void;
+}
+
+/**
+ * Default reporter: structured logging only, so every alert is visible in whatever log pipeline the
+ * deployment already has. Swap this for an adapter that also calls a real provider's API (a
+ * `packages/integrations` adapter, following the same pattern as the SMS/voice providers) without
+ * changing any call site.
+ */
+export function createLoggingErrorReporter(logger: Logger = createConsoleLogger()): ErrorReporter {
+  return {
+    captureAlert(event) {
+      logger.log("error", event.message, { alert_type: event.type, ...event.details });
+    },
+  };
+}
