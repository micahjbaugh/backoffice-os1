+++ b/apps/web/src/server/health.ts
@@ -0,0 +1,31 @@
+import "server-only";
+
+import { createLoggingErrorReporter, type Database, type ErrorReporter } from "@backoffice/core";
+
+export interface HealthResult {
+  status: "ok" | "error";
+}
+
+/**
+ * Liveness/readiness check for uptime monitors and load balancers: does the app's database
+ * connection actually work. Never returns anything beyond ok/error — no connection details, no
+ * error message — since this endpoint has no session and no signature to authenticate its caller.
+ * A failure is still reported through the ErrorReporter so it reaches whatever alerting the
+ * deployment has configured (PH-T04).
+ */
+export async function checkHealth(
+  database: Database,
+  reporter: ErrorReporter = createLoggingErrorReporter(),
+): Promise<HealthResult> {
+  try {
+    await database.transaction((exec) => exec.query("select 1"));
+    return { status: "ok" };
+  } catch (error) {
+    reporter.captureAlert({
+      type: "health_check.database_unreachable",
+      message: "health check: database unreachable",
+      details: { error: error instanceof Error ? error.message : String(error) },
+    });
+    return { status: "error" };
+  }
+}
