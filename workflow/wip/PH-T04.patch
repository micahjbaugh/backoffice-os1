@@ -0,0 +1,47 @@
+// checkHealth backs GET /api/health: no session, no secret (it's for uptime monitors and load
+// balancers); reports ok/error only, and alerts through the ErrorReporter on failure without leaking
+// error detail to the caller. The route itself (`@/` aliased, like every other route in this app) is
+// only reachable through the running app, not a plain module import; see running-app.test.ts for the
+// no-session, no-secret path through proxy.ts and the 200/503 status codes.
+
+import { describe, expect, it, vi } from "vitest";
+import type { ErrorReporter } from "@backoffice/core";
+
+vi.mock("server-only", () => ({}));
+
+import { checkHealth } from "../src/server/health";
+
+function db(query: () => Promise<unknown>) {
+  return {
+    transaction: (fn: (exec: { query: typeof query }) => Promise<unknown>) => fn({ query }),
+  };
+}
+
+function fakeReporter(): ErrorReporter & {
+  captureAlert: ReturnType<typeof vi.fn<ErrorReporter["captureAlert"]>>;
+} {
+  return { captureAlert: vi.fn<ErrorReporter["captureAlert"]>() };
+}
+
+describe("checkHealth", () => {
+  it("is ok when the database answers", async () => {
+    const reporter = fakeReporter();
+    const result = await checkHealth(
+      db(() => Promise.resolve({ rows: [], rowCount: 0 })) as never,
+      reporter,
+    );
+    expect(result).toEqual({ status: "ok" });
+    expect(reporter.captureAlert).not.toHaveBeenCalled();
+  });
+
+  it("is error, without leaking the underlying error, when the database fails", async () => {
+    const reporter = fakeReporter();
+    const database = db(() => Promise.reject(new Error("connection refused: secret-host:5432")));
+    const result = await checkHealth(database as never, reporter);
+    expect(result).toEqual({ status: "error" });
+    expect(JSON.stringify(result)).not.toContain("secret-host");
+    expect(reporter.captureAlert).toHaveBeenCalledWith(
+      expect.objectContaining({ type: "health_check.database_unreachable" }),
+    );
+  });
+});
