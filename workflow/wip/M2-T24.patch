+"use server";
+
+import {
+  cancelDeadWebhookEvent,
+  cancelOutboundOperation,
+  reconcileUnknownOutboundOperation,
+  retryDeadWebhookEvent,
+  retryFailedOutboundOperation,
+} from "@backoffice/core";
+import type { ActionState } from "@/lib/action-state";
+import { field, runAction } from "@/server/actions";
+import { withOperator } from "@/server/session";
+
+const REVALIDATE = ["/ops/operations"];
+
+export async function retryWebhookEventAction(
+  _prev: ActionState,
+  form: FormData,
+): Promise<ActionState> {
+  const id = field(form, "id") ?? "";
+  return runAction(async () => {
+    await withOperator((tx) => retryDeadWebhookEvent(tx, id));
+    return "Event queued for reprocessing.";
+  }, REVALIDATE);
+}
+
+export async function cancelWebhookEventAction(
+  _prev: ActionState,
+  form: FormData,
+): Promise<ActionState> {
+  const id = field(form, "id") ?? "";
+  return runAction(async () => {
+    await withOperator((tx) => cancelDeadWebhookEvent(tx, id));
+    return "Event marked ignored.";
+  }, REVALIDATE);
+}
+
+export async function retryOutboundOperationAction(
+  _prev: ActionState,
+  form: FormData,
+): Promise<ActionState> {
+  const id = field(form, "id") ?? "";
+  return runAction(async () => {
+    await withOperator((tx) => retryFailedOutboundOperation(tx, id));
+    return "Operation queued for retry.";
+  }, REVALIDATE);
+}
+
+export async function cancelOutboundOperationAction(
+  _prev: ActionState,
+  form: FormData,
+): Promise<ActionState> {
+  const id = field(form, "id") ?? "";
+  return runAction(async () => {
+    await withOperator((tx) => cancelOutboundOperation(tx, id));
+    return "Operation cancelled.";
+  }, REVALIDATE);
+}
+
+export async function reconcileOutboundOperationAction(
+  _prev: ActionState,
+  form: FormData,
+): Promise<ActionState> {
+  const id = field(form, "id") ?? "";
+  const succeeded = field(form, "finding") === "succeeded";
+  return runAction(async () => {
+    await withOperator((tx) =>
+      reconcileUnknownOutboundOperation(
+        tx,
+        id,
+        succeeded
+          ? { kind: "succeeded", providerRef: field(form, "providerRef") ?? null }
+          : { kind: "did_not_happen" },
+      ),
+    );
+    return "Operation reconciled.";
+  }, REVALIDATE);
+}
