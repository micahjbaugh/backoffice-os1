+import { listStuckOutboundOperations, listStuckWebhookEvents } from "@backoffice/core";
+import { ActionForm, SubmitButton } from "@/components/ActionForm";
+import { formatDateTime, humanize } from "@/lib/format";
+import { withOperator } from "@/server/session";
+import {
+  cancelOutboundOperationAction,
+  cancelWebhookEventAction,
+  reconcileOutboundOperationAction,
+  retryOutboundOperationAction,
+  retryWebhookEventAction,
+} from "../../actions/ops-operations";
+
+export const dynamic = "force-dynamic";
+
+export default async function OpsOperationsPage() {
+  const { webhooks, outbound } = await withOperator(async (tx) => ({
+    webhooks: await listStuckWebhookEvents(tx),
+    outbound: await listStuckOutboundOperations(tx),
+  }));
+
+  return (
+    <>
+      <div className="page-head">
+        <h1>Stuck operations</h1>
+        <p>
+          Dead webhook events and failed or outcome-unknown outbound operations in organizations
+          that have granted you access. Every action here is audited.
+        </p>
+      </div>
+
+      <section className="section">
+        <h2>Dead webhook events</h2>
+        {webhooks.dead.length === 0 ? (
+          <p className="empty">None.</p>
+        ) : (
+          <div className="table-wrap">
+            <table>
+              <thead>
+                <tr>
+                  <th>Organization</th>
+                  <th>Provider</th>
+                  <th>Event</th>
+                  <th>Attempts</th>
+                  <th>Last error</th>
+                  <th>Received</th>
+                  <th>Actions</th>
+                </tr>
+              </thead>
+              <tbody>
+                {webhooks.dead.map((e) => (
+                  <tr key={e.id}>
+                    <td>{e.organizationName}</td>
+                    <td>{e.provider}</td>
+                    <td>{e.eventType ?? e.eventKey}</td>
+                    <td>{e.attempts}</td>
+                    <td className="meta">{e.lastError}</td>
+                    <td>{formatDateTime(e.receivedAt)}</td>
+                    <td>
+                      <ActionForm
+                        action={retryWebhookEventAction}
+                        className="row"
+                        resetOnSuccess={false}
+                      >
+                        <input type="hidden" name="id" value={e.id} />
+                        <SubmitButton variant="secondary">Retry</SubmitButton>
+                      </ActionForm>
+                      <ActionForm
+                        action={cancelWebhookEventAction}
+                        className="row"
+                        resetOnSuccess={false}
+                      >
+                        <input type="hidden" name="id" value={e.id} />
+                        <SubmitButton variant="danger">Cancel</SubmitButton>
+                      </ActionForm>
+                    </td>
+                  </tr>
+                ))}
+              </tbody>
+            </table>
+          </div>
+        )}
+      </section>
+
+      <section className="section">
+        <h2>Unrouted webhook events</h2>
+        <p className="meta">
+          No provider route exists yet for these; registering one requeues them automatically.
+        </p>
+        {webhooks.unrouted.length === 0 ? (
+          <p className="empty">None.</p>
+        ) : (
+          <div className="table-wrap">
+            <table>
+              <thead>
+                <tr>
+                  <th>Provider</th>
+                  <th>Event</th>
+                  <th>Received</th>
+                </tr>
+              </thead>
+              <tbody>
+                {webhooks.unrouted.map((e) => (
+                  <tr key={e.id}>
+                    <td>{e.provider}</td>
+                    <td>{e.eventType ?? e.eventKey}</td>
+                    <td>{formatDateTime(e.receivedAt)}</td>
+                  </tr>
+                ))}
+              </tbody>
+            </table>
+          </div>
+        )}
+      </section>
+
+      <section className="section">
+        <h2>Failed &amp; unknown outbound operations</h2>
+        {outbound.length === 0 ? (
+          <p className="empty">None.</p>
+        ) : (
+          <div className="table-wrap">
+            <table>
+              <thead>
+                <tr>
+                  <th>Organization</th>
+                  <th>Type</th>
+                  <th>Status</th>
+                  <th>Attempts</th>
+                  <th>Last error</th>
+                  <th>Actions</th>
+                </tr>
+              </thead>
+              <tbody>
+                {outbound.map((o) => (
+                  <tr key={o.id}>
+                    <td>{o.organizationName}</td>
+                    <td>{humanize(o.operationType)}</td>
+                    <td>
+                      <span className={`badge ${o.status === "unknown" ? "yellow" : "red"}`}>
+                        {o.status}
+                      </span>
+                    </td>
+                    <td>{o.attempts}</td>
+                    <td className="meta">{o.lastError}</td>
+                    <td>
+                      {o.status === "failed" ? (
+                        <ActionForm
+                          action={retryOutboundOperationAction}
+                          className="row"
+                          resetOnSuccess={false}
+                        >
+                          <input type="hidden" name="id" value={o.id} />
+                          <SubmitButton variant="secondary">Retry</SubmitButton>
+                        </ActionForm>
+                      ) : null}
+                      <ActionForm
+                        action={cancelOutboundOperationAction}
+                        className="row"
+                        resetOnSuccess={false}
+                      >
+                        <input type="hidden" name="id" value={o.id} />
+                        <SubmitButton variant="danger">Cancel</SubmitButton>
+                      </ActionForm>
+                      {o.status === "unknown" ? (
+                        <ActionForm
+                          action={reconcileOutboundOperationAction}
+                          className="stack"
+                          resetOnSuccess={false}
+                        >
+                          <input type="hidden" name="id" value={o.id} />
+                          <label className="inline">
+                            <input
+                              type="radio"
+                              name="finding"
+                              value="did_not_happen"
+                              defaultChecked
+                            />{" "}
+                            Confirmed: did not happen
+                          </label>
+                          <label className="inline">
+                            <input type="radio" name="finding" value="succeeded" /> Confirmed:
+                            succeeded
+                          </label>
+                          <input
+                            name="providerRef"
+                            placeholder="Provider reference (optional)"
+                            maxLength={200}
+                          />
+                          <SubmitButton>Mark reconciled</SubmitButton>
+                        </ActionForm>
+                      ) : null}
+                    </td>
+                  </tr>
+                ))}
+              </tbody>
+            </table>
+          </div>
+        )}
+      </section>
+    </>
+  );
+}
