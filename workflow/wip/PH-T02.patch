+
+  it("a tampered cursor is treated as the first page, not an error", async () => {
+    const page = await asOwner((ctx) =>
+      listCustomers(ctx, { cursor: "not-a-real-cursor", limit: 2 }),
+    );
+    expect(page.items.length).toBeGreaterThan(0);
+  });
+});
