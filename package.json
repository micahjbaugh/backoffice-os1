{
  "name": "backoffice-os",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test && pnpm test:workflow",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:workflow": "node --test --test-timeout=120000 workflow/test/referee.test.mjs",
    "test:tz": "pnpm --filter @backoffice/core test:tz"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.4",
    "eslint": "^9.39.5",
    "prettier": "^3.9.9",
    "supabase": "^2.118.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  }
}
