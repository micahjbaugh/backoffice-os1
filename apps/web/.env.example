# ---------------------------------------------------------------------------
# Browser-visible (NEXT_PUBLIC_*). Only public values belong here.
# ---------------------------------------------------------------------------
# Supabase project URL and *anon* (publishable) key. Local CLI values: `supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key

# ---------------------------------------------------------------------------
# Server-only secrets. NEVER prefix with NEXT_PUBLIC_.
# ---------------------------------------------------------------------------
# Direct Postgres connection used by server code. This role bypasses RLS for trusted writes;
# user-scoped queries drop to the `authenticated` role with the user's claims.
# Local CLI default:
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Hosted Supabase: use the pooler connection string (transaction mode is fine; all session
# settings are transaction-local).

# M1 does not use the Supabase service-role key. Do not add it unless a feature needs it,
# and never expose it to the browser.
# SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Communications providers (server-only). See packages/integrations/src/runtime-config.ts.
# ---------------------------------------------------------------------------
# Development default: fake providers. They need an explicit webhook secret (16+ chars) and have
# no built-in default. Production refuses fake providers entirely.
BO_PROVIDER_MODE=fake
FAKE_PROVIDER_WEBHOOK_SECRET=
# Live providers (BO_PROVIDER_MODE=live; always in production). All required; placeholders and
# known test values are rejected. TWILIO_WEBHOOK_URL is the exact public https URL configured in
# Twilio for /api/webhooks/sms (no query string).
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WEBHOOK_URL=
# VAPI_API_KEY=
# VAPI_WEBHOOK_SECRET=

# Bearer secret for POST /api/internal/jobs (webhook processing, outbound dispatch,
# reconciliation). 32+ characters; the endpoint is disabled without it.
INTERNAL_JOBS_SECRET=
