# ---------------------------------------------------------------------------
# Browser-visible (NEXT_PUBLIC_*). Only public values belong here.
# ---------------------------------------------------------------------------
# Supabase project URL and *anon* (publishable) key. Local CLI values: `supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key

# ---------------------------------------------------------------------------
# Server-only secrets. NEVER prefix with NEXT_PUBLIC_.
# ---------------------------------------------------------------------------
# Direct Postgres connection used by server code. Must be the least-privilege `app_server` role
# (migration 0017_app_server_role.sql), never the table-owning/migration role: it owns nothing and
# only has the grants + RLS policies trusted server writes need. User-scoped queries drop to the
# `authenticated` role with the user's claims (full RLS, same as a direct Supabase client).
# Local CLI: run `supabase db push` (or apply migrations), then
# `alter role app_server with password 'local-dev-password';` once, and use that below. Hosted
# Supabase: same `alter role`, then use the pooler connection string (transaction mode is fine;
# all session settings are transaction-local).
DATABASE_URL=postgresql://app_server:local-dev-password@127.0.0.1:54322/postgres

# Required in live mode (PH-T03): signs private document downloads via Supabase Storage. Never
# expose it to the browser.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# Private Storage bucket documents live in (migration 0019_document_storage.sql). Defaults to
# "documents" if unset.
# DOCUMENT_STORAGE_BUCKET=

# ---------------------------------------------------------------------------
# Communications providers (server-only). See packages/integrations/src/runtime-config.ts.
# ---------------------------------------------------------------------------
# Development default: fake providers. They need an explicit webhook secret (16+ chars) and have
# no built-in default. Production refuses fake providers entirely.
BO_PROVIDER_MODE=fake
FAKE_PROVIDER_WEBHOOK_SECRET=
# Live providers (BO_PROVIDER_MODE=live; always in production). All required; placeholders and
# known test values are rejected. TWILIO_WEBHOOK_URL is the exact public https URL configured in
# Twilio for /api/webhooks/sms (no query string).
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WEBHOOK_URL=
# VAPI_API_KEY=
# VAPI_WEBHOOK_SECRET=

# Bearer secret for POST /api/internal/jobs (webhook processing, outbound dispatch,
# reconciliation). 32+ characters; the endpoint is disabled without it.
INTERNAL_JOBS_SECRET=
